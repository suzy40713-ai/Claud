# Connexion PostgreSQL (obligatoire). En local avec Docker Compose (docker-compose.yml
# fourni), utilise par exemple :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/faitstory?schema=public"

# Fournisseur de synthese vocale (TTS). "espeak" = gratuit, sans cle, tourne en local
# via le binaire espeak-ng (doit etre installe sur le serveur). Laisser vide = espeak.
TTS_PROVIDER=espeak

# Fournisseur d'images. "pollinations" = gratuit, sans cle, via l'API publique
# Pollinations.ai. "local" = image de test generee localement (aucun reseau),
# utile en dev ou si Pollinations est indisponible. Laisser vide = pollinations.
IMAGE_PROVIDER=pollinations
