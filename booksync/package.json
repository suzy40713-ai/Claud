{
  "name": "booksync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --import tsx src/db/migrate.ts && next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:e2e": "NEXT_PUBLIC_APP_URL=http://localhost:3100 next build"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "geist": "^1.9.1",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
