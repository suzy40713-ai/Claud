# ──────────────────────────────────────────────────────────────
# BookSync — variables d'environnement
# Copier en `.env.local` (développement). Ne jamais commiter de secret.
# ──────────────────────────────────────────────────────────────

# Base de données PostgreSQL
#   Local : postgres://postgres@localhost:5432/booksync_dev
#   Supabase (production) : Project Settings → Database → Connection string
#     → « Session pooler » (port 5432), avec ?sslmode=require
DATABASE_URL=postgres://postgres@localhost:5432/booksync_dev
DATABASE_POOL_MAX=10

# URL publique de l'application (sans / final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentification — secret aléatoire d'au moins 32 caractères
#   Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacez-moi-par-un-secret-aleatoire-de-32-caracteres
# Limitation du nombre de tentatives de connexion (on | off — off réservé aux tests)
AUTH_RATE_LIMIT=on

# Emails transactionnels (Resend — offre gratuite : 3 000 emails/mois)
#   Sans clé, les emails sont enregistrés en base sans être envoyés,
#   et consultables en développement sur /dev/emails.
# RESEND_API_KEY=re_...
# EMAIL_FROM="BookSync <notifications@votre-domaine.fr>"

# ── À venir (étapes suivantes) ────────────────────────────────
# STRIPE_SECRET_KEY=           # Étape 8 — abonnements Starter / Pro
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_PRO_MONTHLY=
