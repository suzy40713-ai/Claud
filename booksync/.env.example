# ──────────────────────────────────────────────────────────────
# BookSync — variables d'environnement
# Copier en `.env.local` (développement). Ne jamais commiter de secret.
# ──────────────────────────────────────────────────────────────

# Base de données PostgreSQL
#   Local : postgres://postgres@localhost:5432/booksync_dev
#   Supabase (production) : Project Settings → Database → Connection string
#     → « Session pooler » (port 5432), avec ?sslmode=require
DATABASE_URL=postgres://postgres@localhost:5432/booksync_dev
DATABASE_POOL_MAX=10

# URL publique de l'application (sans / final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentification — secret aléatoire d'au moins 32 caractères
#   Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacez-moi-par-un-secret-aleatoire-de-32-caracteres
# Limitation du nombre de tentatives de connexion (on | off — off réservé aux tests)
AUTH_RATE_LIMIT=on

# Emails transactionnels (Resend — offre gratuite : 3 000 emails/mois)
#   Sans clé, les emails sont enregistrés en base sans être envoyés,
#   et consultables en développement sur /dev/emails.
# RESEND_API_KEY=re_...
# EMAIL_FROM="BookSync <notifications@votre-domaine.fr>"

# Planificateur des rappels : secret partagé avec Supabase pg_cron (24 caractères minimum)
#   Générer : openssl rand -hex 32
# CRON_SECRET=

# Stripe Billing — MODE TEST pendant le développement (sk_test_…)
#   Produits et prix : STRIPE_SECRET_KEY=sk_test_... pnpm tsx scripts/stripe-setup.ts [URL du webhook]
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...

# Connexion avec Google (facultatif) — Google Cloud Console → Identifiants → ID client OAuth
#   URI de redirection autorisée : {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Mentions légales (informations de votre société)
# NEXT_PUBLIC_LEGAL_COMPANY="BookSync SAS"
# NEXT_PUBLIC_LEGAL_FORM="SAS au capital de 1 000 €"
# NEXT_PUBLIC_LEGAL_ADDRESS="12 rue …, 75000 Paris"
# NEXT_PUBLIC_LEGAL_SIREN="RCS Paris 000 000 000"
# NEXT_PUBLIC_LEGAL_VAT="FR00000000000"
# NEXT_PUBLIC_LEGAL_DIRECTOR="Prénom Nom"
# NEXT_PUBLIC_LEGAL_EMAIL="contact@votre-domaine.fr"
