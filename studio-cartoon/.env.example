# Clé secrète Stripe (Dashboard > Développeurs > Clés API). Commence par sk_live_ ou sk_test_.
STRIPE_SECRET_KEY=
# Prix en centimes (2900 = 29,00 €)
PRICE_CENTS=2900
CURRENCY=eur
# Adresse publique du site, sans / final (ex. https://studio-cartoon.onrender.com)
PUBLIC_ORIGIN=
# Longue chaîne aléatoire qui signe les liens d'accès. NE JAMAIS la changer après les premières ventes.
ACCESS_SECRET=
# Envoi des emails (resend.com) : lien d'accès + PDF après achat, aperçu gratuit
RESEND_API_KEY=
SENDER_EMAIL=Studio Cartoon <formation@ton-domaine.fr>
# Optionnel : reçoit une notification à chaque inscription à l'aperçu gratuit
LEAD_NOTIFY_EMAIL=
