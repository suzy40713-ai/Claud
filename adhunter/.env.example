# ---------------------------------------------------------------------------
# AdHunter — environment variables. Copy to .env.local and fill in.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; ALL others are
# server-only and must never be prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (REQUIRED) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails always treated as admins (bootstrap the first admin)
ADMIN_EMAILS=

# Stripe (required for paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Set to true once Stripe Tax is configured in your Stripe dashboard
STRIPE_AUTOMATIC_TAX=false

# AI — Anthropic Claude (required for AI Analyzer / Ad Creator)
ANTHROPIC_API_KEY=
# Optional: model and effort (low | medium | high). Lower effort = lower cost.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Ad sources — official APIs only
# Meta Ad Library API: https://www.facebook.com/ads/library/api
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
# TikTok Commercial Content API (approval required): https://developers.tiktok.com/products/commercial-content-api
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Demo mode: enables a clearly labelled fictional ad source + template AI outputs
DEMO_MODE=false

# Legal identity (shown in Mentions légales / CGV) — REQUIRED before going live
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_HOST=
NEXT_PUBLIC_LEGAL_MEDIATOR=
