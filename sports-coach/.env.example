POSTGRES_USER=sportscoach
POSTGRES_PASSWORD=sportscoach
POSTGRES_DB=sportscoach

DATABASE_URL=postgresql://sportscoach:sportscoach@postgres:5432/sportscoach

JWT_SECRET=change-me-in-production

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# A utiliser en production quand le backend est appele depuis une origine
# differente (ex: app mobile Capacitor packagee, origine "https://localhost").
# Liste separee par des virgules, ex: https://localhost,https://mon-app.com
ADDITIONAL_CORS_ORIGINS=
# "lax" fonctionne quand front et back sont sur le meme "site" (dev web).
# Passer a "none" si le back est appele depuis une origine vraiment
# differente (app mobile packagee) : force aussi le cookie en Secure (HTTPS
# obligatoire cote backend dans ce cas).
COOKIE_SAME_SITE=lax

# Requis pour le coach IA conversationnel (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5

# Requis pour les notifications push (alerte de surcharge). Genere via :
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
OVERLOAD_CHECK_INTERVAL_MS=21600000

# Requis pour l'import automatique Strava. Cree une appli sur
# https://www.strava.com/settings/api pour obtenir ces identifiants.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback

# Requis pour l'abonnement premium (coach IA, import Strava, alertes push).
# Cle secrete et prix recurrent depuis https://dashboard.stripe.com/apikeys
# et https://dashboard.stripe.com/products. Le secret de webhook s'obtient en
# creant un endpoint vers /api/billing/webhook dans le dashboard Stripe (ou
# via `stripe listen --forward-to localhost:4000/api/billing/webhook` en dev).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Ebook "Transformation 90 Jours" (paiement unique, sans compte requis).
# Reutilise STRIPE_SECRET_KEY ci-dessus, pas besoin de creer un Price cote
# Stripe Dashboard : le prix ci-dessous est envoye directement a Stripe.
EBOOK_PRICE_CENTS=2999
EBOOK_COMPARE_AT_PRICE_CENTS=4999

# Requis pour l'envoi automatique du PDF de l'ebook par email apres achat.
# Cle API depuis https://resend.com/api-keys. Sans domaine verifie cote
# Resend, "onboarding@resend.dev" fonctionne mais avec des limitations de
# volume/destinataires : verifier un domaine des que possible.
RESEND_API_KEY=
EBOOK_SENDER_EMAIL=Kadence IA <onboarding@resend.dev>
