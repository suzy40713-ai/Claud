generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  course_a_pied
  velo
}

enum Niveau {
  debutant
  intermediaire
  avance
}

enum Objectif {
  perte_de_poids
  preparation_course
  regularite
  performance
}

enum ActivitySource {
  fit
  gpx
  tcx
  manuel
  strava
}

enum SessionStatut {
  a_faire
  fait
  ajuste
  skip
}

enum CoachRole {
  user
  assistant
}

enum SubscriptionStatus {
  aucun
  actif
  impaye
  annule
}

enum EbookDeliveryStatus {
  en_attente
  envoye
  echec
}

enum ChallengeStatut {
  reussi
  echoue
  manque
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  objectif           Objectif?
  sportsPratiques    Sport[]  @map("sports_pratiques")
  niveau             Niveau?
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  createdAt          DateTime @default(now()) @map("created_at")

  lastAcwrAlertAt DateTime? @map("last_acwr_alert_at")

  stravaAthleteId      String?   @unique @map("strava_athlete_id")
  stravaAccessToken    String?   @map("strava_access_token")
  stravaRefreshToken   String?   @map("strava_refresh_token")
  stravaTokenExpiresAt DateTime? @map("strava_token_expires_at")
  stravaLastSyncAt     DateTime? @map("strava_last_sync_at")

  stripeCustomerId              String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId          String?            @unique @map("stripe_subscription_id")
  subscriptionStatus            SubscriptionStatus @default(aucun) @map("subscription_status")
  subscriptionCurrentPeriodEnd  DateTime?           @map("subscription_current_period_end")

  injuryHistory     InjuryHistory[]
  activities        Activity[]
  dailyLogs         DailyLog[]
  trainingPlans     TrainingPlan[]
  coachMessages     CoachMessage[]
  pushSubscriptions PushSubscription[]
  groceryLists      GroceryList[]
  mealScans         MealScan[]
  rankProfile       RankProfile?
  pushupChallenges  PushupChallenge[]

  @@map("users")
}

// Rang de motivation de l'utilisateur (defi hebdomadaire de pompes).
// Cree paresseusement au premier appel a GET /rang.
model RankProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rang                 Int       @default(0) // 0=Bronze .. 4=Diamant
  derniereSemaineResolue DateTime? @map("derniere_semaine_resolue") @db.Date // lundi de la derniere semaine deja prise en compte dans le rang
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("rank_profiles")
}

// Une tentative au defi hebdomadaire de pompes. Au plus une par
// utilisateur et par semaine (voir contrainte unique). Comme pour le scan
// de repas, seules quelques images extraites de la video sont envoyees a
// l'IA pour analyse ; rien n'est stocke cote serveur au-dela du resultat.
model PushupChallenge {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  semaineDebut    DateTime        @map("semaine_debut") @db.Date // lundi de la semaine concernee
  statut          ChallengeStatut
  repsDetectees   Int             @map("reps_detectees")
  formeValide     Boolean         @map("forme_valide")
  commentaire     String
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([userId, semaineDebut])
  @@map("pushup_challenges")
}

// Liste de courses generee par l'IA a partir du profil de l'utilisateur
// (objectif, niveau, sports pratiques). Fonctionnalite premium.
model GroceryList {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json // [{ categorie: string, nom: string, quantite: string }]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("grocery_lists")
}

// Analyse d'une photo de plat par l'IA (calories/macros estimes). L'image
// elle-meme n'est jamais stockee, seul le resultat de l'analyse l'est.
model MealScan {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  calories    Int
  proteinesG  Int      @map("proteines_g")
  glucidesG   Int      @map("glucides_g")
  lipidesG    Int      @map("lipides_g")
  confiance   String // "faible" | "moyenne" | "haute"
  adequationObjectif  String @map("adequation_objectif") // "adapte" | "a_moderer" | "a_eviter"
  commentaireObjectif String @map("commentaire_objectif")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("meal_scans")
}

// Achat unitaire de l'ebook "Transformation 90 Jours", independant d'un
// compte utilisateur (achat possible sans connexion, juste avec un email).
model EbookPurchase {
  id                    String              @id @default(uuid())
  email                 String
  product               String              @default("transformation-90-jours") // identifiant du produit achete (voir PRODUCTS dans ebook.service.ts)
  stripeSessionId       String              @unique @map("stripe_session_id")
  stripePaymentIntentId String?             @map("stripe_payment_intent_id")
  amountTotal           Int                 @map("amount_total") // centimes
  deliveryStatus        EbookDeliveryStatus @default(en_attente) @map("delivery_status")
  deliveryError         String?             @map("delivery_error")
  createdAt             DateTime            @default(now()) @map("created_at")
  deliveredAt           DateTime?           @map("delivered_at")

  @@map("ebook_purchases")
}

// Email laisse par un visiteur pas encore pret a acheter, en echange d'un
// mini-guide gratuit envoye immediatement par email. Independant d'un
// compte utilisateur (comme EbookPurchase) : capturable sans connexion.
//
// nurtureStep/nextNurtureAt pilotent une relance automatique courte (2
// emails apres le mini-guide initial) : 0 = seul le mini-guide est parti,
// 1 = la 1ere relance est partie, 2 = sequence terminee (plus aucun envoi).
model EmailLead {
  id            String    @id @default(uuid())
  email         String    @unique
  source        String // ex: "ebook_page"
  nurtureStep   Int       @default(0) @map("nurture_step")
  nextNurtureAt DateTime? @map("next_nurture_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("email_leads")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model InjuryHistory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone       String
  type       String
  dateApprox DateTime? @map("date_approx")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("injury_history")
}

model Activity {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  sport         Sport
  duree         Int // secondes
  distance      Float // metres
  denivele      Float?
  fcMoyenne     Int?           @map("fc_moyenne")
  allureMoyenne Float?         @map("allure_moyenne") // secondes/km
  sourceFormat  ActivitySource @map("source_format")
  sourceFile    String?        @map("source_file")
  stravaId      String?        @unique @map("strava_id")
  rawData       Json?          @map("raw_data")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("activities")
}

model DailyLog {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  sommeil  Int
  fatigue  Int
  stress   Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date])
  @@map("daily_logs")
}

model TrainingPlan {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semaineDebut  DateTime @map("semaine_debut") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  seances PlannedSession[]

  @@unique([userId, semaineDebut])
  @@map("training_plans")
}

model PlannedSession {
  id                String        @id @default(uuid())
  planId            String        @map("plan_id")
  plan              TrainingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  date              DateTime      @db.Date
  sport             Sport
  type              String
  dureeCible        Int           @map("duree_cible") // secondes
  intensiteCible    String        @map("intensite_cible")
  statut            SessionStatut @default(a_faire)
  raisonAjustement  String?       @map("raison_ajustement")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([planId, date])
  @@map("planned_sessions")
}

model CoachMessage {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CoachRole
  content   String
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("coach_messages")
}
